services:
  collector:
    build: ./app
    ports:
      - "8080:8080"
    user: "${UID:-1000}:${GID:-1000}"
    volumes:
      - ./data:/data
      - ./library:/library
      - ./policies:/policies:ro
    environment:
      - DB_PATH=/data/collector.db
      - LIBRARY_ROOT=/library/store
      - POLICIES_PATH=/policies/policies.yml
