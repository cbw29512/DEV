def detect_chrome_major(default=0) -> int:
    """Try to detect installed Chrome major version. Falls back to 0 (auto)."""
    try:
        out = subprocess.check_output([CHROME_BIN, "--version"], text=True).strip()
        parts = out.split()
        for p in parts:
            if p and p[0].isdigit() and "." in p:
                return int(p.split(".")[0])
    except Exception:
        pass
    return default


def is_invalid_session(exc: Exception) -> bool:
    s = str(exc).lower()
    return (
        "invalid session id" in s
        or "session deleted because of page crash" in s
        or "chrome not reachable" in s
        or "disconnected" in s
        or "no such window" in s
        or "target window already closed" in s
    )


def human_pause():
    time.sleep(UA_WAIT_MIN + random.random() * UA_WAIT_RAND)


def page_has_nonzero_money(text: str) -> bool:
    """If page contains ANY $X.XX where it's not $0.00, treat as non-free."""
    amounts = re.findall(r"\$[0-9]+(?:\.[0-9]{2})?", text)
    for a in amounts:
        if a.strip() != "$0.00":
            return True
    return False


