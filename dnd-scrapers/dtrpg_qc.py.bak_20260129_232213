def which_chrome() -> str:
    for p in CHROME_CANDIDATES:
        if Path(p).exists():
            return p
    for name in ["google-chrome-stable", "google-chrome", "chromium-browser", "chromium"]:
        p = shutil.which(name)
        if p:
            return p
    return "/usr/bin/google-chrome"


CHROME_BIN = which_chrome()


def detect_chrome_major(default=0) -> int:
    try:
        out = subprocess.check_output([CHROME_BIN, "--version"], text=True).strip()
        # "Google Chrome 144.0.7559.109"
        parts = out.split()
        for p in parts:
            if p and p[0].isdigit() and "." in p:
                return int(p.split(".")[0])
    except Exception:
        pass
    return default


def is_invalid_session(exc: Exception) -> bool:
    s = str(exc).lower()
    return (
        "invalid session id" in s
        or "session deleted because of page crash" in s
        or "chrome not reachable" in s
        or "disconnected" in s
        or "not connected to devtools" in s
        or "no such window" in s
    )


def cleanup_uc_cache_best_effort():
    # UC caches under ~/.local/share/undetected_chromedriver on Linux
    try:
        shutil.rmtree(Path.home() / ".local/share/undetected_chromedriver", ignore_errors=True)
    except Exception:
        pass
    # Some temp patterns
    try:
        for p in Path("/tmp").glob("uc_*"):
            shutil.rmtree(p, ignore_errors=True)
    except Exception:
        pass


def chrome_using_profile(profile_dir: Path) -> bool:
    # Heuristic: if Chrome is open AND the profile has Singleton* locks, it's likely in use.
    try:
        has_locks = any((profile_dir / n).exists() for n in ["SingletonLock", "SingletonSocket", "SingletonCookie"])
        if not has_locks:
            return False
        # if any chrome process is running, assume in use
        r = subprocess.run(["pgrep", "-fa", "chrome"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return r.returncode == 0
    except Exception:
        return False


def cleanup_profile_locks(profile_dir: Path):
    for n in ["SingletonLock", "SingletonSocket", "SingletonCookie"]:
        try:
            (profile_dir / n).unlink(missing_ok=True)
        except Exception:
            pass


