    def smart_click(self, driver, element):
        try:
            driver.execute_script("arguments[0].scrollIntoView({block:'center'});", element)
            time.sleep(0.25)
        except Exception:
            pass
        try:
            element.click()
            return "native"
        except Exception:
            pass
        try:
            ActionChains(driver).move_to_element(element).pause(0.1).click(element).perform()
            return "actions"
        except Exception:
            pass
        try:
            driver.execute_script("arguments[0].click();", element)
        except Exception:
            pass
        return "js"

    def is_logged_in(self, driver) -> bool:
        try:
            html = (driver.page_source or "").lower()
        except Exception:
            return False
        return ("logoff" in html) or ("my account" in html) or ("/en/library" in html)

    def has_real_challenge(self, driver) -> bool:
        """
        IMPORTANT:
        - We do NOT trigger on mere presence of 'turnstile' text anymore (false positives).
        - We trigger only when actual challenge DOM elements / CF URLs appear.
        """
        try:
            url = (driver.current_url or "").lower()
        except Exception:
            url = ""

        try:
            title = (driver.execute_script("return document.title") or "").lower()
        except Exception:
            title = ""

        # URL/title signals (strong)
        if "cdn-cgi" in url or "challenge-platform" in url:
            return True
        if "just a moment" in title or "checking your browser" in title:
            return True

        # DOM signals (strong)
        js = r"""
        try {
          const sels = [
            "div.cf-turnstile",
            "input[name='cf-turnstile-response']",
            "iframe[src*='turnstile']",
            "iframe[src*='challenge']",
            "iframe[id*='cf']",
            "#cf-challenge-running",
            "form[action*='challenge']",
            "div[id*='challenge']"
          ];
          for (const sel of sels) {
            const el = document.querySelector(sel);
            if (el) return true;
          }
          // Classic CF page text blocks
          const body = (document.body && document.body.innerText || "").toLowerCase();
          if (body.includes("checking your browser") || body.includes("verify you are human") || body.includes("just a moment")) return true;
          return false;
        } catch(e) { return false; }
        """
        try:
            return bool(driver.execute_script(js))
        except Exception:
            return False

    def guard_interstitial(self, driver, context: str) -> bool:
        if self.has_real_challenge(driver):
            try:
                title = driver.execute_script("return document.title") or ""
            except Exception:
                title = ""
            try:
                url = driver.current_url or ""
            except Exception:
                url = ""
            self.log(f"GUARD: real verification detected ({context}) title='{title}' url={url}")
            self.debug_dump(driver, f"challenge_{context}")
            dbg_dir = str(Path(self.download_path.get()) / "_debug")
            self.blocking_modal(
                "Verification Detected",
                "A real verification/challenge page was detected.\n\n"
                f"Chrome tab title: {title}\n"
                f"URL: {url}\n\n"
                "It may be in a NEW TAB.\n"
                "Alt-Tab to Chrome and look for a tab like 'Just a moment…'.\n\n"
                f"If you still don't see it, open the saved screenshot in:\n{dbg_dir}\n\n"
                "Solve it in Chrome, then click Continue."
            )
            return True

        # logged-out guard
        try:
            url_l = (driver.current_url or "").lower()
        except Exception:
            url_l = ""
        if "login.php" in url_l and not self.is_logged_in(driver):
            self.log(f"GUARD: login page detected ({context}) url={url_l}")
            self.blocking_modal(
                "Login Required",
                "You appear to be logged out.\n\nLog in in Chrome, then click Continue.\n"
                "Afterwards return to your filtered results page."
            )
            return True

        return False

    def get_cart_badge_count(self, driver):
        candidates = [
            (By.CSS_SELECTOR, "#cart_count"),
            (By.CSS_SELECTOR, ".cart-count"),
            (By.CSS_SELECTOR, "a[href*='cart'] .count"),
            (By.CSS_SELECTOR, "a[href*='cart'] span"),
        ]
        for by, sel in candidates:
            try:
                el = driver.find_element(by, sel)
                txt = (el.text or "").strip()
                digits = "".join(c for c in txt if c.isdigit())
                if digits:
                    return int(digits)
            except Exception:
                pass
        return None

    def wait_cart_change(self, driver, before, timeout_s: float):
        if before is None:
            return None
        end = time.time() + timeout_s
        while time.time() < end:
            now = self.get_cart_badge_count(driver)
            if now is not None and now != before:
                return True
            time.sleep(0.25)
        return False

